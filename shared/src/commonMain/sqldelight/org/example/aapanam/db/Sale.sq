CREATE TABLE sale (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    customer_id INTEGER,
    total_amount REAL NOT NULL DEFAULT 0.0,
    paid_amount REAL NOT NULL DEFAULT 0.0,
    payment_mode TEXT NOT NULL,
    sale_date INTEGER NOT NULL,
    is_credit INTEGER NOT NULL DEFAULT 0,
    is_synced INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    FOREIGN KEY(customer_id) REFERENCES customer(id) ON DELETE SET NULL
);

CREATE TABLE sale_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sale_id INTEGER NOT NULL,
    item_id INTEGER NOT NULL,
    item_name TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 0,
    unit_price REAL NOT NULL DEFAULT 0.0,
    total_price REAL NOT NULL DEFAULT 0.0,
    created_at INTEGER NOT NULL,
    FOREIGN KEY(sale_id) REFERENCES sale(id) ON DELETE CASCADE
);

-- Indexes for better performance
CREATE INDEX idx_sale_date ON sale(sale_date);
CREATE INDEX idx_sale_payment_mode ON sale(payment_mode);
CREATE INDEX idx_sale_sync ON sale(is_synced);
CREATE INDEX idx_sale_customer ON sale(customer_id);
CREATE INDEX idx_sale_item_sale_id ON sale_item(sale_id);
CREATE INDEX idx_sale_item_item_id ON sale_item(item_id);

-- Sale Queries
getSaleById:
SELECT * FROM sale
WHERE id = ?;

getAllSales:
SELECT * FROM sale
ORDER BY sale_date DESC, id DESC;

getCreditSales:
SELECT * FROM sale
WHERE is_credit = 1
ORDER BY sale_date DESC;

getSalesByDateRange:
SELECT * FROM sale
WHERE sale_date BETWEEN ? AND ?
ORDER BY sale_date DESC;

getTodaySales:
SELECT * FROM sale
WHERE date(sale_date, 'unixepoch') = date('now')
ORDER BY sale_date DESC;

getSalesByPaymentMode:
SELECT * FROM sale
WHERE payment_mode = ?
ORDER BY sale_date DESC;

getUnsyncedSales:
SELECT * FROM sale
WHERE is_synced = 0
ORDER BY sale_date DESC;

getSalesByCustomerId:
SELECT * FROM sale
WHERE customer_id = ?
ORDER BY sale_date DESC;

getTotalSalesCount:
SELECT COUNT(*) FROM sale;

getSalesSummary:
SELECT
    COUNT(*) AS total_sales,
    SUM(total_amount) AS total_revenue,
    AVG(total_amount) AS average_sale,
    SUM(paid_amount) AS total_paid,
    SUM(total_amount - paid_amount) AS total_credit
FROM
    sale;

getDailySales:
SELECT
    date(sale_date, 'unixepoch') AS sale_day,
    COUNT(*) AS sales_count,
    SUM(total_amount) AS daily_revenue
FROM
    sale
GROUP BY
    sale_day
ORDER BY
    sale_day DESC;
    
last_insert_rowid: SELECT last_insert_rowid();

upsertSale:
INSERT OR REPLACE INTO sale (id, customer_id, total_amount, paid_amount, payment_mode, sale_date, is_credit, is_synced, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSale:
INSERT INTO sale (
    customer_id,
    total_amount,
    paid_amount,
    payment_mode,
    sale_date,
    is_credit,
    is_synced,
    created_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateSale:
UPDATE sale
SET
    customer_id = ?,
    total_amount = ?,
    paid_amount = ?,
    payment_mode = ?,
    sale_date = ?,
    is_credit = ?,
    is_synced = ?
WHERE id = ?;

updateSaleSyncStatus:
UPDATE sale
SET is_synced = ?
WHERE id = ?;

markAllSalesAsSynced:
UPDATE sale
SET is_synced = 1;

updateSalePayment:
UPDATE sale
SET paid_amount = ?, is_credit = ?
WHERE id = ?;

deleteSaleById:
DELETE FROM sale
WHERE id = ?;

deleteAllSales:
DELETE FROM sale;

-- Sale Item Queries
getSaleItemById:
SELECT * FROM sale_item
WHERE id = ?;

getSaleItemsBySaleId:
SELECT * FROM sale_item
WHERE sale_id = ?
ORDER BY id;

getSaleItemsByItemId:
SELECT
    si.*,
    s.sale_date
FROM
    sale_item AS si
JOIN
    sale AS s
    ON si.sale_id = s.id
WHERE
    si.item_id = ?
ORDER BY
    s.sale_date DESC;


getTotalQuantitySoldByItem:
SELECT item_id, SUM(quantity) AS total_sold
FROM sale_item
GROUP BY item_id;

upsertSaleItem:
INSERT OR REPLACE INTO sale_item (id, sale_id, item_id, item_name, quantity, unit_price, total_price, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertSaleItem:
INSERT INTO sale_item (
    sale_id,
    item_id,
    item_name,
    quantity,
    unit_price,
    total_price,
    created_at
)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateSaleItem:
UPDATE sale_item
SET
    item_name = ?,
    quantity = ?,
    unit_price = ?,
    total_price = ?
WHERE id = ?;

deleteSaleItemById:
DELETE FROM sale_item
WHERE id = ?;

deleteSaleItemsBySaleId:
DELETE FROM sale_item
WHERE sale_id = ?;

deleteAllSaleItems:
DELETE FROM sale_item;